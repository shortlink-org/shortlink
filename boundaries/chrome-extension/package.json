{
  "name": "shortlink",
  "description": "A simple URL shortener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-webstorage' wxt",
    "dev:firefox": "NODE_OPTIONS='--no-webstorage' wxt -b firefox",
    "build": "NODE_OPTIONS='--no-webstorage' wxt build",
    "build:firefox": "NODE_OPTIONS='--no-webstorage' wxt build -b firefox",
    "zip": "NODE_OPTIONS='--no-webstorage' wxt zip",
    "zip:firefox": "NODE_OPTIONS='--no-webstorage' wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "NODE_OPTIONS='--no-webstorage' wxt prepare"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "4.2.2",
    "typescript": "^6.0.3",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
