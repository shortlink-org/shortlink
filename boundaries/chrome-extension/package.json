{
  "name": "shortlink",
  "description": "A simple URL shortener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-webstorage' wxt",
    "dev:firefox": "NODE_OPTIONS='--no-webstorage' wxt -b firefox",
    "build": "NODE_OPTIONS='--no-webstorage' wxt build",
    "build:firefox": "NODE_OPTIONS='--no-webstorage' wxt build -b firefox",
    "zip": "NODE_OPTIONS='--no-webstorage' wxt zip",
    "zip:firefox": "NODE_OPTIONS='--no-webstorage' wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "NODE_OPTIONS='--no-webstorage' wxt prepare"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "4.2.2",
    "typescript": "^6.0.3",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
