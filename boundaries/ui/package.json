{
  "name": "ui-next",
  "version": "1.0.1",
  "description": "This UI for shortlink application",
  "repository": "https://github.com/shortlink-org/shortlink.git",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production pnpm next build --turbopack",
    "dev": "NODE_OPTIONS='--max-http-header-size=131072' pnpm next dev",
    "dev:dev": "cp .env.dev .env.local && pnpm dev",
    "dev:k8s": "cp .env.k8s .env.local && pnpm dev",
    "dev:prod": "cp .env.prod .env.local && pnpm dev",
    "type-check": "tsc",
    "next-lint": "pnpm dlx next lint",
    "prettier": "pnpm dlx prettier -w -c .",
    "inspector": "pnpm dlx @eslint/config-inspector",
    "lint": "pnpm dlx eslint ./ --max-warnings 0 --report-unused-disable-directives --cache",
    "lint:fix": "pnpm dlx eslint --fix",
    "lint:gitlab": "pnpm dlx lint --format gitlab",
    "swagger": "pnpm dlx swagger-typescript-api -p ../../api/swagger.json -o ./store/api -d -r --modular --axios",
    "sitemap": "pnpm dlx next-sitemap --config config/sitemap.config.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm build && playwright test",
    "e2e:dev": "playwright test",
    "e2e:headed": "playwright test --headed",
    "playwright:codegen": "playwright codegen http://localhost:3000/next/add-link",
    "playwright:report": "allure serve playwright-report/allure-results",
    "preinstall": "npx only-allow pnpm"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && pnpm lint"
    }
  },
  "keywords": [],
  "author": "Victor Login <batazor111@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shortlink-org/shortlink/issues/new?template=bug_report.md",
    "email": "batazor111@gmail.com"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "2.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@next/env": "^16.2.4",
    "@ory/client": "^1.22.66",
    "@ory/integrations": "^1.3.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/nextjs": "^10.47.0",
    "@shortlink-org/eslint-plugin-shortlink": "0.20250809.193608",
    "@shortlink-org/ui-kit": "^0.20260407.113159",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.99.0",
    "axios": "^1.15.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "5.2.1",
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "js-cookie": "^3.0.8",
    "jspdf-autotable": "^5.0.7",
    "localforage": "1.10.0",
    "lodash": "^4.18.1",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "19.2.5",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "19.2.5",
    "react-redux": "^9.2.0",
    "react-wrap-balancer": "^1.1.1",
    "redux": "^5.0.1",
    "redux-saga": "^1.4.2",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "shortlink-ui-kit": "^1.4.5",
    "sonner": "^2.0.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@playwright/test": "^1.59.1",
    "@redux-devtools/extension": "^4.0.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/material-ui": "^0.21.18",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@vitejs/plugin-react": "^6.0.1",
    "allure-playwright": "^3.7.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.0.2",
    "next-sitemap": "^4.2.3",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
